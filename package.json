{
  "name": "bolosaathi",
  "version": "1.0.0",
  "description": "BoloSaathi - Voice-first Indian Public Services Assistant",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
